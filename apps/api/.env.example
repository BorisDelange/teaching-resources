# Copiez ce fichier en « .env » et renseignez vos valeurs.
# Le fichier .env ne doit JAMAIS être commité (voir .gitignore).

# Fournisseur des modèles : « openrouter » (défaut) ou « edenai ».
# Seule la clé du fournisseur choisi est utilisée. Sans elle, le serveur
# démarre mais chaque appel à un modèle répond 503.
LLM_PROVIDER=openrouter

# Clé API OpenRouter. https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Clé API Eden AI (agrégateur français). https://app.edenai.run/settings/api-keys
# Les slugs du TD sont traduits en noms Eden hébergés en Europe (voir
# PROVIDERS dans app/main.py) ; MODEL_MAP permet d'en changer :
# MODEL_MAP=meta-llama/llama-3.3-70b-instruct=deepinfra/meta-llama/Llama-3.3-70B-Instruct
EDENAI_API_KEY=sk-eden-...

# Origines autorisées à appeler le backend (CORS), séparées par des virgules.
# En dev : le serveur Vite. En prod : l'URL exacte du site déployé.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Liste blanche des modèles appelables (recommandé en prod pour éviter les abus).
# Slugs OpenRouter, quel que soit le fournisseur. Vide = tout modèle autorisé.
ALLOWED_MODELS=google/gemma-3-4b-it,mistralai/mistral-small-24b-instruct-2501,meta-llama/llama-3.3-70b-instruct,openai/gpt-6-luna

# En-têtes d'attribution OpenRouter (facultatif, ignorés par Eden AI).
SITE_URL=https://teaching-resources-96e174.frama.io
SITE_NAME=Ressources pédagogiques — TD chatbots
